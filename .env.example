# Required: Discord Developer Portal -> Application -> Bot
DISCORD_BOT_TOKEN=

# Required for hosted deployment with Supabase PostgreSQL.
# Copy the Shared Pooler -> Session mode URI from Supabase -> Connect.
# Replace the password placeholder and URL-encode reserved characters.
DATABASE_URL=

# Optional AI provider settings (Groq is the included OpenAI-compatible default).
# Create your own API key in the provider dashboard; do not share or commit it.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_MAX_TOKENS=700
AI_HISTORY_LIMIT=12

# Local development only: used when DATABASE_URL is blank.
DB_PATH=data/bot.sqlite3

# Optional: set a test Discord server ID to update slash commands immediately.
# Leave blank for global commands.
COMMAND_GUILD_ID=

# Render sets PORT automatically. Keep this only for local testing if desired.
PORT=10000
LOG_LEVEL=INFO
